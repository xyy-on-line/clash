;控制vlan20段全网段地址的直连
SRC-IP-CIDR,192.168.20.0/24,no-resolve
;控制主路由分配的10全网段地址的直连
SRC-IP-CIDR,192.168.10.0/24,no-resolve

;控制vlan30段地址的直连IP地址范围11-254
SRC-IP-CIDR,192.168.30.11/32,no-resolve
SRC-IP-CIDR,192.168.30.12/30,no-resolve
SRC-IP-CIDR,192.168.30.16/28,no-resolve
SRC-IP-CIDR,192.168.30.32/27,no-resolve
SRC-IP-CIDR,192.168.30.64/26,no-resolve
SRC-IP-CIDR,192.168.30.128/25,no-resolve

;控制子路由的40地址段直连地址范围11-254
SRC-IP-CIDR,192.168.40.11/32,no-resolve
SRC-IP-CIDR,192.168.40.12/30,no-resolve
SRC-IP-CIDR,192.168.40.16/28,no-resolve
SRC-IP-CIDR,192.168.40.32/27,no-resolve
SRC-IP-CIDR,192.168.40.64/26,no-resolve
SRC-IP-CIDR,192.168.40.128/25,no-resolve
